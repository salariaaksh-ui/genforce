# Copy to .env.local and fill in per client. Never commit .env.local.

# --- Site ---
# Production origin (canonical URLs, sitemap, robots, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example-agency.com

# --- Contact form (Resend) ---
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiries are delivered (the client's inbox). TODO(client): set this.
CONTACT_TO_EMAIL=TODO(client)@example.com
# Verified sender in the client's Resend domain (must be a domain you verified
# in Resend, e.g. no-reply@example-agency.com). Enquirer's address is used as
# reply-to, so agents reply straight to the lead.
CONTACT_FROM_EMAIL=no-reply@example-agency.com
