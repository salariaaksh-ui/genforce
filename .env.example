# Copy to .env and fill in. Never commit .env.

# Postgres connection string (e.g. Neon free tier, or local Postgres)
DATABASE_URL=postgres://user:password@host:5432/genforce

# Auth.js session secret — generate with: npx auth secret
AUTH_SECRET=change-me

# Google OAuth client (Google Cloud Console > Credentials > OAuth client, Web)
# Authorized redirect URI: http://localhost:3007/api/auth/callback/google
AUTH_GOOGLE_ID=placeholder
AUTH_GOOGLE_SECRET=placeholder

# Public site origin (canonical/sitemap/OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3007

# Razorpay (course payments). Dashboard > Settings > API Keys (start in Test mode).
# Webhook secret: Dashboard > Settings > Webhooks, event "payment.captured",
# URL https://<your-domain>/api/webhooks/razorpay
RAZORPAY_KEY_ID=placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder

# Offline dev only: set to 1 (with no real keys) to simulate payments without
# a Razorpay account. MUST be unset in production.
# RAZORPAY_MOCK=1
